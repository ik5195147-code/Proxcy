# 32 hex chars. Generate with: openssl rand -hex 16   (comma-separate for several secrets)
SECRET=
# Optional: protect the dashboard with a password (browser login, any username)
DASHBOARD_PASSWORD=
# Optional: 32-hex tag from @MTProxybot (sponsored channel)
PROXY_TAG=
# Port MTProxy listens on inside the container (Railway TCP Proxy "application port")
PROXY_PORT=8443
# Override what the dashboard advertises (auto-detected on Railway TCP Proxy)
PUBLIC_HOST=
PUBLIC_PORT=
# MTProxy worker processes
WORKERS=1
